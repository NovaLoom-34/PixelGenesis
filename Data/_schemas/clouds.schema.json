{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "clouds",
 "type": "object",
 "required": [
  "category",
  "items"
 ],
 "properties": {
  "category": {
   "const": "clouds"
  },
  "count": {
   "type": "integer"
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "effect",
     "id",
     "name"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^cloud\\.[a-z0-9_]+$"
     },
     "name": {
      "type": "string"
     },
     "effect": {
      "type": "string"
     }
    },
    "additionalProperties": true
   }
  }
 }
}