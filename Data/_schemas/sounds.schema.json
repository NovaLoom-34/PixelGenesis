{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "sounds",
 "type": "object",
 "required": [
  "category",
  "items"
 ],
 "properties": {
  "category": {
   "const": "sounds"
  },
  "count": {
   "type": "integer"
  },
  "items": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "files",
     "volume",
     "category",
     "trigger"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^snd\\.[a-z0-9_]+$"
     },
     "category": {
      "enum": [
       "sfx",
       "ui",
       "ambient",
       "music"
      ]
     }
    },
    "additionalProperties": true
   }
  }
 }
}